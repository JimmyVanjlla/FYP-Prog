# Copy this file to .env and fill in real values. .env itself is gitignored
# — never commit real credentials.

# Supabase: Project Settings -> Database -> Connection string -> "URI",
# then swap the postgresql:// scheme for postgresql+psycopg://
# Example: postgresql+psycopg://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# Upstash (or any Redis provider): copy the "Redis Connect URL" it gives you.
# Not used by any code until the Demand Forecasting sprint (Celery), but set
# it now so switching over later is a no-op.
# Example: rediss://default:YOUR-PASSWORD@your-instance.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ENVIRONMENT=development

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API (e.g. a web admin panel). Leave empty for a
# mobile-only deployment — the Flutter app isn't affected either way.
# Example: CORS_ALLOWED_ORIGINS=https://admin.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Max failed /auth/login attempts per email within the window before
# further attempts are rejected with 429 (brute-force protection).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
